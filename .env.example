# Telegram
TELEGRAM_BOT_TOKEN=
ALLOWED_TELEGRAM_USER_IDS=

# ComfyUI must remain local.
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_WORKFLOW_PATH=./src/workflows/workflow_api.json
COMFYUI_CHECKPOINT_NAME=
COMFYUI_POLL_INTERVAL_MS=2000
COMFYUI_TIMEOUT_MS=240000
COMFYUI_REQUEST_TIMEOUT_MS=10000
COMFYUI_IDLE_TIMEOUT_MS=300000
COMFYUI_CLEANUP_TIMEOUT_MS=30000
COMFYUI_CLEANUP_POLL_INTERVAL_MS=1000
COMFYUI_CLEANUP_MIN_RELEASE_MB=64
COMFYUI_CLEANUP_FREE_RATIO=0.7
COMFYUI_CLEANUP_STABLE_SAMPLES=2

# Copy these exact IDs and input names from your exported API workflow.
COMFYUI_POSITIVE_PROMPT_NODE_ID=67
COMFYUI_POSITIVE_PROMPT_INPUT=text
COMFYUI_CHECKPOINT_NODE_ID=73
COMFYUI_CHECKPOINT_INPUT=ckpt_name
COMFYUI_SEED_NODE_ID=94
COMFYUI_SEED_INPUT=seed
COMFYUI_ADDITIONAL_SEED_MAPPINGS=
COMFYUI_SAVE_IMAGE_NODE_ID=84

# Optional fully local scene interpretation, selected per Telegram account.
PROMPT_ENHANCEMENT_AVAILABLE=true
PROMPT_ENHANCEMENT_FALLBACK_TO_RAW=false
PROMPT_ENHANCEMENT_MAX_LENGTH=2400
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=hf.co/mradermacher/Gemma-The-Writer-9B-HERETIC-Uncensored-Abliterated-i1-GGUF:Q6_K
OLLAMA_AUTO_START=true
OLLAMA_EXECUTABLE_PATH=ollama
OLLAMA_STARTUP_TIMEOUT_MS=30000
OLLAMA_REQUEST_TIMEOUT_MS=180000
OLLAMA_UNLOAD_TIMEOUT_MS=30000
OLLAMA_POLL_INTERVAL_MS=500
OLLAMA_SYSTEM_PROMPT_PATH=./src/prompts/scene-director.txt
OLLAMA_TEMPERATURE=0.35
OLLAMA_TOP_P=0.9
OLLAMA_NUM_PREDICT=700
OLLAMA_NUM_CTX=8192

# Runtime limits
GENERATION_SEED=
GENERATION_QUEUE_MAX_SIZE=5
PROMPT_MAX_LENGTH=3500
TELEGRAM_ACTION_INTERVAL_MS=4000
UPDATE_DEDUP_TTL_MS=600000
