# Telegram
TELEGRAM_BOT_TOKEN=
ALLOWED_TELEGRAM_USER_ID=

# ComfyUI must remain local.
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_WORKFLOW_PATH=./src/workflows/workflow_api.json
COMFYUI_POLL_INTERVAL_MS=2000
COMFYUI_TIMEOUT_MS=240000
COMFYUI_REQUEST_TIMEOUT_MS=10000

# Copy these exact IDs and input names from your exported API workflow.
COMFYUI_POSITIVE_PROMPT_NODE_ID=
COMFYUI_POSITIVE_PROMPT_INPUT=text
COMFYUI_SEED_NODE_ID=
COMFYUI_SEED_INPUT=seed
COMFYUI_SAVE_IMAGE_NODE_ID=

# Runtime limits
GENERATION_QUEUE_MAX_SIZE=5
PROMPT_MAX_LENGTH=1500
TELEGRAM_ACTION_INTERVAL_MS=4000
UPDATE_DEDUP_TTL_MS=600000
UPDATE_DEDUP_MAX_SIZE=1000
LOG_LEVEL=info
